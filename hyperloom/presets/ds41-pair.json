{
  "receipt": "P17.5 production defaults",
  "engine_sha": "70ec42b9b5ead86c42cd673eff19bea3c09bd1df",
  "port": 18431,
  "binary": "strix-deepseek41-serve",
  "assets": [
    "ds41_model",
    "dspark",
    "ds41_vocab",
    "overlay",
    "trellis_k4",
    "trellis_k5"
  ],
  "argv": [
    "{binary}",
    "{ds41_model}",
    "--rank",
    "{rank}",
    "--transport",
    "usb4gpu",
    "--prefill-path",
    "device",
    "--dspark",
    "{dspark}",
    "--dspark-vocab",
    "auto:{ds41_vocab}",
    "--http-bind",
    "{address}",
    "--http-port",
    "{port}",
    "--http-api-key-file",
    "{key_file}"
  ],
  "env": {
    "STRIX_DS41_OVERLAY": "{overlay}",
    "STRIX_DS41_CB4": "1",
    "STRIX_DS41_TRELLIS": "{trellis_k4}",
    "STRIX_DS41_TRELLIS_MIX": "head={trellis_k5}",
    "STRIX_DS41_TRELLIS_SITES": "shexp,head",
    "STRIX_DS41_TRELLIS_HEADOUT": "1"
  },
  "knobs": {
    "--default-max-tokens": {
      "min": 1,
      "max": 4096
    },
    "--peer-timeout": {
      "min": 1,
      "max": 3600
    },
    "--http-port": {
      "min": 1,
      "max": 65535
    },
    "--slots": {
      "min": 4,
      "max": 4,
      "values": [
        4
      ]
    },
    "--context": {
      "min": 4096,
      "max": 4096,
      "values": [
        4096
      ]
    }
  },
  "advanced": {
    "dspark_max_inflight": {
      "kind": "argv",
      "target": "--dspark-max-inflight",
      "values": [
        4,
        0
      ],
      "production": 4,
      "effect": "0 drafts at every load (DSpark always on); 4 runs plain steps while more than 4 requests are in flight",
      "qualification": {
        "receipt": "P17.1 timing campaign (serve C1..C8)",
        "engine_sha": "70ec42b9b5ead86c42cd673eff19bea3c09bd1df",
        "evidence": "docs/ds41-production-defaults.md, Code defaults: serve --dspark-max-inflight (4 keeps C1..C4 +19..+76 % without the C8 TTFT cost)"
      }
    },
    "dspark_ranks": {
      "kind": "argv",
      "target": "--dspark-ranks",
      "values": [
        2,
        1
      ],
      "production": 2,
      "effect": "1 keeps the drafter on rank 0 only",
      "qualification": {
        "receipt": "P17.1 timing campaign",
        "engine_sha": "70ec42b9b5ead86c42cd673eff19bea3c09bd1df",
        "evidence": "docs/ds41-production-defaults.md, Code defaults: serve --dspark-ranks (2, off = 1)"
      }
    },
    "serve_sched": {
      "kind": "env",
      "target": "STRIX_DS41_SERVE_SCHED",
      "values": [
        "interleave",
        "off"
      ],
      "production": "interleave",
      "effect": "off: no interleaved prefill under load (8K prompt stalls decode ~13 s instead of <= 1 s; its own TTFT about halves)",
      "qualification": {
        "receipt": "P17.1 timing campaign (8K prompt under load)",
        "engine_sha": "70ec42b9b5ead86c42cd673eff19bea3c09bd1df",
        "evidence": "docs/ds41-production-defaults.md, Code defaults: STRIX_DS41_SERVE_SCHED"
      }
    }
  }
}
