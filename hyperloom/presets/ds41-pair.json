{
  "receipt": "P17.5 production defaults",
  "engine_sha": "9211b07e13c64ab80ae04fcbfcbeab50fe0cbf04",
  "port": 18431,
  "binary": "strix-deepseek41-serve",
  "assets": [
    "ds41_model",
    "dspark",
    "ds41_vocab",
    "overlay",
    "trellis_k4",
    "trellis_k5"
  ],
  "argv": [
    "{binary}",
    "{ds41_model}",
    "--rank",
    "{rank}",
    "--transport",
    "usb4gpu",
    "--prefill-path",
    "device",
    "--dspark",
    "{dspark}",
    "--dspark-vocab",
    "auto:{ds41_vocab}",
    "--http-bind",
    "{address}",
    "--http-port",
    "{port}",
    "--http-api-key-file",
    "{key_file}"
  ],
  "env": {
    "STRIX_DS41_OVERLAY": "{overlay}",
    "STRIX_DS41_CB4": "1",
    "STRIX_DS41_TRELLIS": "{trellis_k4}",
    "STRIX_DS41_TRELLIS_MIX": "head={trellis_k5}",
    "STRIX_DS41_TRELLIS_SITES": "shexp,head",
    "STRIX_DS41_TRELLIS_HEADOUT": "1"
  },
  "knobs": {
    "--default-max-tokens": {
      "min": 1,
      "max": 4096
    },
    "--peer-timeout": {
      "min": 1,
      "max": 3600
    },
    "--http-port": {
      "min": 1,
      "max": 65535
    },
    "--slots": {
      "min": 4,
      "max": 4,
      "values": [
        4
      ]
    },
    "--context": {
      "min": 4096,
      "max": 4096,
      "values": [
        4096
      ]
    }
  },
  "diagnostics": {
    "rank1-prefill-log": {
      "description": "Rank 1 logs each prefill's token count, next token and logits FNV on stderr (exactness evidence).",
      "env": {
        "STRIX_DS41_SERVE_PREFILL_LOG": "1"
      },
      "output": "stderr",
      "source": [
        "apps/deepseek41_serve_main.cpp:77-78@9211b07e",
        "apps/deepseek41_serve_main.cpp:815-819@9211b07e"
      ]
    },
    "dist-latency-trace": {
      "description": "Per-thread CLOCK_MONOTONIC marks of the USB4 exchange, buffered in memory and written as CSV at thread exit (nothing is written if the process is killed with SIGKILL).",
      "env": {
        "STRIX_DIST_LATENCY_TRACE": "{log_dir}/diag-{run}-{role}-dist-latency"
      },
      "output": "files {log_dir}/diag-{run}-{role}-dist-latency.t<tid>.csv",
      "source": [
        "src/dist_latency_trace.hpp:1-2@9211b07e",
        "src/dist_latency_trace.hpp:15-19@9211b07e",
        "src/dist_communicator.cpp:159-167@9211b07e"
      ]
    }
  }
}
